# Postgres credentials (shared by the postgres service and backend's DATABASE_URL)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Host port mappings — change if a port is already taken on your machine
POSTGRES_PORT=5432
BACKEND_PORT=3000
FRONTEND_PORT=3001

# Absolute host path to the Obsidian vault root (parent of raw/, wiki/, log.md).
# Bind-mounted into the backend container at /vault. Must be the SAME vault
# path the natively-running Capture Bot writes into (see capture-bot/.env).
VAULT_HOST_PATH=
