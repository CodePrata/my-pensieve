# Bot token from BotFather
TELEGRAM_CAPTURE_BOT_TOKEN=

# The single Telegram numeric user ID permitted to use the bot
TELEGRAM_ALLOWED_USER_ID=

# Absolute path to the Obsidian vault root (parent of raw/, wiki/, log.md)
OBSIDIAN_VAULT_PATH=

# Local Ollama HTTP API base URL
OLLAMA_BASE_URL=http://localhost:11434

# Vision-capable model for image captioning (check `ollama list` on the target machine)
OLLAMA_VISION_MODEL=llava

# ADR-018: async video audio transcription enrichment (optional)
VIDEO_TRANSCRIPTION_ENABLED=
WHISPER_ENGINE=
WHISPER_CPP_BIN=
WHISPER_MODEL_PATH=
YT_DLP_PATH=
FFMPEG_PATH=
# Optional; defaults to FFMPEG_PATH with ffmpeg -> ffprobe substitution
FFPROBE_PATH=