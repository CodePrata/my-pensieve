DATABASE_URL=

GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=

# Used in briefing narration greetings (e.g. "Good Morning Alex,")
USER_FIRST_NAME=YourName

# Absolute path to the Obsidian vault root (parent of raw/, wiki/, log.md) —
# same vault the Capture Bot writes into. Used by the Knowledge Inbox pipeline.
OBSIDIAN_VAULT_PATH=

# Telegram push briefing delivery (POST /briefing/push). Must be the SAME bot
# token and SAME allowlisted user ID already configured in capture-bot/.env
# (TELEGRAM_CAPTURE_BOT_TOKEN / TELEGRAM_ALLOWED_USER_ID) — one bot covers both
# capture and briefing delivery (ADR-009). TELEGRAM_ALLOWED_USER_ID doubles as
# the chat_id for outbound sendMessage calls.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# GitHub personal access token used by the Knowledge Inbox's GitHub import
# source (POST /knowledge/sync-github) to read README + commit history for
# repos tracked via Project.repoUrl. Needs read access to those repos only —
# for public repos, no special scope is required (a token with no scopes
# checked still authenticates and raises the API rate limit); for private
# repos, grant the `repo` scope (classic token) or Contents: Read-only
# (fine-grained token).
GITHUB_TOKEN=