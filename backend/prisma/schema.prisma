// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CalendarEvent {
  id            String   @id @default(cuid())
  externalId    String   @unique
  title         String
  startTime     DateTime
  endTime       DateTime
  allDay        Boolean
  isRecurring   Boolean
  source        String
  lastSyncedAt  DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CalendarOAuthToken {
  id           String    @id @default(cuid())
  provider     String    @unique @default("google")
  accessToken  String
  refreshToken String
  scope        String?
  tokenType    String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BriefingSnapshot {
  id             String             @id @default(cuid())
  date           DateTime           @db.Date
  generatedAt    DateTime
  degraded       Boolean            @default(false)
  degradedReason String?
  narration      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  priorities     BriefingPriority[]
}

model BriefingPriority {
  id           String           @id @default(cuid())
  snapshotId   String
  snapshot     BriefingSnapshot @relation(fields: [snapshotId], references: [id])
  priorityType String
  referenceId  String
  rank         Int
  createdAt    DateTime         @default(now())
}

model StudyTopic {
  id                       String    @id @default(cuid())
  name                     String
  examName                 String
  domain                   String
  status                   String
  deadline                 DateTime? @db.Date
  notes                    String?
  importance               String    @default("medium")
  estimatedDurationMinutes Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model Project {
  id                       String    @id @default(cuid())
  name                     String
  repoUrl                  String
  status                   String
  description              String?
  importance               String    @default("medium")
  dueDate                  DateTime? @db.Date
  estimatedDurationMinutes Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}