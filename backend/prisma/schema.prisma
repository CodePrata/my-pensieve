// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CalendarEvent {
  id            String   @id @default(cuid())
  externalId    String   @unique
  title         String
  // Synced verbatim from Google Calendar's API response (source of truth is
  // Google, per data-model.md) — not locally derived, so no local-midnight
  // ambiguity applies here (contrast with BriefingSnapshot.date below).
  startTime     DateTime
  endTime       DateTime
  allDay        Boolean
  isRecurring   Boolean
  source        String
  lastSyncedAt  DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CalendarOAuthToken {
  id           String    @id @default(cuid())
  provider     String    @unique @default("google")
  accessToken  String
  refreshToken String
  scope        String?
  tokenType    String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BriefingSnapshot {
  id             String             @id @default(cuid())
  // `date` reflects server-LOCAL midnight (per ADR-003's single-machine
  // assumption), not UTC. Querying with Postgres's CURRENT_DATE will not
  // match rows generated after local midnight but before UTC midnight —
  // always compare against a locally-derived startOfDay(), not CURRENT_DATE.
  date           DateTime           @db.Date
  generatedAt    DateTime
  degraded       Boolean            @default(false)
  degradedReason String?
  narration      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  priorities     BriefingPriority[]
}

model BriefingPriority {
  id           String           @id @default(cuid())
  snapshotId   String
  snapshot     BriefingSnapshot @relation(fields: [snapshotId], references: [id])
  priorityType String
  referenceId  String
  rank         Int
  createdAt    DateTime         @default(now())
}

model StudyTopic {
  id                       String    @id @default(cuid())
  name                     String
  examName                 String
  domain                   String
  status                   String
  // Date-only (no time component), manually entered by the user (ADR-011) —
  // no timezone conversion applies at write time (contrast with
  // BriefingSnapshot.date above).
  deadline                 DateTime? @db.Date
  notes                    String?
  importance               String    @default("medium")
  estimatedDurationMinutes Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model Project {
  id                       String    @id @default(cuid())
  name                     String
  repoUrl                  String
  status                   String
  description              String?
  importance               String    @default("medium")
  // Date-only (no time component), manually entered by the user (ADR-011) —
  // no timezone conversion applies at write time (contrast with
  // BriefingSnapshot.date above).
  dueDate                  DateTime? @db.Date
  estimatedDurationMinutes Int?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model RawItem {
  id            String           @id @default(cuid())
  sourceType    String
  captureMethod String
  sourceUrl     String?
  rawFilePath   String           @unique
  capturedAt    DateTime
  processed     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  wikiSources   WikiPageSource[]
}

model WikiPage {
  id            String           @id @default(cuid())
  title         String
  concept       String?
  filePath      String           @unique
  summary       String?
  lastUpdatedAt DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  rawSources    WikiPageSource[]
}

model WikiPageSource {
  id         String   @id @default(cuid())
  rawItemId  String
  rawItem    RawItem  @relation(fields: [rawItemId], references: [id])
  wikiPageId String
  wikiPage   WikiPage @relation(fields: [wikiPageId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([rawItemId, wikiPageId])
}